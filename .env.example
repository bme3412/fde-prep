# State persistence (Upstash Redis via Vercel Marketplace integration)
#
# Provision on Vercel: Storage → Marketplace → Upstash for Redis → link.
# This injects the two REST variables below into the project automatically.
# For local dev, run:  vercel env pull .env.local
#
# When these are unset, the app falls back to filesystem (data/state.json),
# which works locally but is read-only on Vercel deployments.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Passcode gate
#
# When APP_PASSCODE is set, every route except /login requires a valid auth
# cookie. The cookie value is HMAC(passcode, session_secret), so the raw
# passcode is never stored client-side.
#
# When APP_PASSCODE is unset, the gate is disabled (useful for local dev).
APP_PASSCODE=
APP_SESSION_SECRET=
